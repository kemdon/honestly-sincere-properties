---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const services = [
  {
    no: '01',
    name: '住宅買賣',
    en: 'Sales & Purchase',
    desc: '由揀樓、實地視察到文件往來，按你的預算與需要，把每個步驟逐項解釋清楚。',
  },
  {
    no: '02',
    name: '住宅租賃',
    en: 'Leasing',
    desc: '租客與業主的條件配對、睇樓安排及租務文件，由代理陪同跟進。',
  },
  {
    no: '03',
    name: '業主放盤',
    en: 'Listing',
    desc: '手上有單位想出售或出租，可先談談物業狀況與期望，再商討資料整理與推廣安排。',
  },
  {
    no: '04',
    name: '物業諮詢',
    en: 'Consultation',
    desc: '想了解區內市況、物業估價或換樓考慮，歡迎直接與代理傾談。',
  },
];
---

<Layout
  title="西營盤地產代理 · 買賣租賃放盤"
  description="真誠地產代理有限公司，位於香港西營盤第三街康和花園地下 6 號鋪。提供住宅買賣、租賃、業主放盤及物業諮詢服務。公司牌照 C-094108-A000，電話 9431 0299。"
  path="/"
>
  <SiteHeader current="/" />

  <main>
    <!-- Hero -->
    <section class="hero" aria-label="真誠地產代理有限公司">
      <div class="hero__media">
        <img
          src="/images/hero-street.webp"
          alt="清晨的香港西營盤斜坡街道，兩旁是舊唐樓與關上的店舖鐵閘，遠處可見高層住宅與海港"
          width="2731"
          height="1536"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <span class="hero__side" aria-hidden="true">Third Street · Sai Ying Pun · Hong Kong</span>

      <div class="container hero__content">
        <div class="hero__body">
          <span class="eyebrow eyebrow--light">Honestly Sincere Properties Limited</span>
          <h1>在西營盤，<em>認真</em>為你<br />找一間屋</h1>
          <p class="hero__lede">
            真誠地產代理有限公司，門市設於西營盤第三街康和花園地下。買賣、租賃、業主放盤，由熟悉這條街的人，陪你把每個細節問清楚。
          </p>
          <div class="hero__actions">
            <a class="btn btn--gold" href="/contact">搵樓 · 放盤查詢 <span class="arrow">→</span></a>
            <a class="btn btn--outline" href="/services">了解服務範圍</a>
          </div>
        </div>
      </div>

      <div class="hero__bar">
        <dl class="container hero__bar-grid">
          <div class="hero__fact">
            <dt>Company Licence</dt>
            <dd>地產代理牌照 C-094108-A000</dd>
          </div>
          <div class="hero__fact">
            <dt>Address</dt>
            <dd>香港西營盤第三街 83 號康和花園地下 6 號鋪</dd>
          </div>
          <div class="hero__fact">
            <dt>Telephone</dt>
            <dd><a href="tel:+85294310299">9431 0299</a></dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Statement -->
    <section class="section--tight" style="padding:0">
      <div class="container" style="padding: clamp(56px,6vw,92px) 0; display:flex; align-items:center; justify-content:space-between; gap:32px; flex-wrap:wrap;">
        <p class="section-title" style="max-width:760px; font-size:clamp(1.5rem,2.6vw,2.3rem);">
          一間地區小店，做的也是地區的事。<br /><span style="color:var(--brass)">真誠，是願意把話說明白。</span>
        </p>
        <a class="text-link" href="/about">認識我們 <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- Services -->
    <section class="section section--warm" id="services">
      <div class="container split">
        <div class="section-head reveal">
          <div class="section-head__top">
            <span class="num">01</span>
            <span class="eyebrow">Our Services</span>
          </div>
          <h2 class="section-title">由一條街開始，<br />把樓市的事說清楚</h2>
          <p class="lede">
            買屋、租屋、放盤，從來不只是價錢與面積。地段、樓齡、朝向、管理、文件，每一項都值得談清楚。我們把服務範圍攤開來講，讓你知道可以怎樣找我們幫忙。
          </p>
          <figure class="figure figure--tall" style="margin-top:18px; max-width:420px;">
            <img src="/images/stone-steps.webp" alt="西營盤一帶的石階斜巷，兩旁是舊牆、盆栽與金屬欄杆" width="1728" height="2304" loading="lazy" decoding="async" />
            <figcaption class="figure__caption">西營盤街區 · 石階與舊牆</figcaption>
          </figure>
        </div>

        <div class="reveal">
          <p class="small-caps" style="color:var(--brass); margin-bottom:26px;">服務範圍 / What we do</p>
          <div class="service-list">
            {services.map((item) => (
              <div class="service-row">
                <span class="num">{item.no}</span>
                <div>
                  <h3 class="service-row__name">{item.name}</h3>
                  <p class="service-row__en">{item.en}</p>
                  <p class="service-row__desc">{item.desc}</p>
                </div>
                <span class="service-row__arrow" aria-hidden="true">→</span>
              </div>
            ))}
          </div>
          <a class="btn btn--outline-dark" href="/services" style="margin-top:38px;">查看服務詳情 <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- Two doors -->
    <section class="duo" aria-label="搵樓與放盤">
      <article class="duo__item">
        <img src="/images/interior-living.webp" alt="香港住宅客廳，木地板、淺色梳妝與透入自然光的窗戶" width="2496" height="1664" loading="lazy" decoding="async" />
        <div class="duo__content">
          <span class="eyebrow eyebrow--light">For buyers &amp; tenants</span>
          <h3>想搵樓？</h3>
          <p>告訴我們預算、面積與心儀路段，按你的條件篩選合適選擇，再安排實地視察。不合適的，我們也會如實說。</p>
          <a class="text-link" href="/contact">聯絡我們 <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="duo__item">
        <img src="/images/keys-desk.webp" alt="木桌上放著門匙、平面圖、卷尺與文件夾，窗光斜照" width="2496" height="1664" loading="lazy" decoding="async" />
        <div class="duo__content">
          <span class="eyebrow eyebrow--light">For owners &amp; landlords</span>
          <h3>想放盤？</h3>
          <p>手上有單位想出售或出租？先談談物業狀況與你的期望，再商討資料整理與推廣安排，一步一步來。</p>
          <a class="text-link" href="/contact">聯絡我們 <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </section>

    <!-- District band -->
    <section class="district-band">
      <img src="/images/harbour-west.webp" alt="傍晚的香港西部海旁，樓群、山巒與海面上的船隻" width="2731" height="1536" loading="lazy" decoding="async" />
      <div class="container district-band__inner">
        <div class="district-band__text">
          <div class="section-head__top">
            <span class="num" style="color:var(--brass-light)">02</span>
            <span class="eyebrow eyebrow--light">The Neighbourhood</span>
          </div>
          <h2>西營盤，是我們每天走的路</h2>
          <p>
            由第三街的斜坡、街市與舊唐樓，一路走到海旁與港鐵站。新舊樓宇交錯、街道高低起伏，是這區最真實的日常；門市就在這裡，看的也是這裡的樓。
          </p>
          <a class="btn btn--outline" href="/district" style="margin-top:30px;">認識西營盤 <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <div class="fact-grid">
          <div class="fact-grid__item">
            <p class="fact-grid__label">Our address</p>
            <h3 class="fact-grid__value">第三街 83 號</h3>
            <p class="fact-grid__note">門市設於康和花園地下 6 號鋪，位處西營盤的主要街道之一。</p>
          </div>
          <div class="fact-grid__item">
            <p class="fact-grid__label">District</p>
            <h3 class="fact-grid__value">中西區 · 港島西</h3>
            <p class="fact-grid__note">西營盤屬香港中西區，接連上環、堅尼地城與薄扶林一帶。</p>
          </div>
          <div class="fact-grid__item">
            <p class="fact-grid__label">Getting here</p>
            <h3 class="fact-grid__value">港鐵西營盤站</h3>
            <p class="fact-grid__note">港鐵港島綫設有西營盤站，區內亦有多條巴士及小巴路線。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Agent -->
    <section class="section section--warm">
      <div class="container split split--even">
        <figure class="figure figure--portrait reveal">
          <img src="/images/door-detail.webp" alt="舊唐樓的墨綠色木門、黃銅信箱口與摺疊式鐵閘特寫" width="1728" height="2304" loading="lazy" decoding="async" />
          <figcaption class="figure__caption">西營盤舊樓 · 門戶細節</figcaption>
        </figure>
        <div class="reveal">
          <div class="section-head__top">
            <span class="num">03</span>
            <span class="eyebrow">Your Agent</span>
          </div>
          <h2 class="section-title" style="margin-top:22px;">直接找得到的人</h2>
          <p class="lede" style="margin:18px 0 32px;">牌照資料公開列明，電話直接接通，不用猜究竟是誰在跟進你的事。</p>

          <div class="agent-card">
            <span class="agent-card__licence">代理牌照 E-458976</span>
            <h3>陳小玲</h3>
            <p class="agent-card__en">Olivia Chan</p>
            <dl style="margin:0;">
              <div class="agent-card__line"><dt>直線電話</dt><dd><a href="tel:+85296856656" style="font-family:var(--font-serif); font-size:1.15rem;">9685 6656</a></dd></div>
              <div class="agent-card__line"><dt>代理牌照</dt><dd>E-458976</dd></div>
              <div class="agent-card__line"><dt>所屬公司</dt><dd>真誠地產代理有限公司</dd></div>
              <div class="agent-card__line"><dt>辦事處</dt><dd>西營盤第三街 83 號康和花園地下 6 號鋪</dd></div>
            </dl>
            <a class="btn btn--ink" href="tel:+85296856656">致電陳小玲 <span class="arrow">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- How we work -->
    <section class="section">
      <div class="container split">
        <div class="reveal">
          <div class="section-head__top">
            <span class="num">04</span>
            <span class="eyebrow">How we work</span>
          </div>
          <h2 class="section-title" style="margin-top:22px;">手續可以繁複，<br />溝通應該直接</h2>
          <p class="lede" style="margin-top:20px; max-width:460px;">
            地產代理的工作，很大部分是整理資料與來回確認。我們把能說清楚的先說清楚，剩下的，见面或電話慢慢談。
          </p>
          <a class="text-link" href="/services" style="margin-top:30px;">看看服務流程 <span aria-hidden="true">→</span></a>
        </div>
        <div class="reveal">
          <figure class="figure figure--wide">
            <img src="/images/planning-desk.webp" alt="辦公桌上攤開的住宅平面圖、筆記本、眼鏡、間尺與門匙" width="2496" height="1664" loading="lazy" decoding="async" />
          </figure>
          <div class="value-grid" style="margin-top:46px;">
            <div class="value-item">
              <span class="value-item__num">01</span>
              <h3>牌照資料清晰</h3>
              <p>公司牌照 C-094108-A000 與代理牌照 E-458976 均列明於網站，查詢時可直接核對。</p>
            </div>
            <div class="value-item">
              <span class="value-item__num">02</span>
              <h3>專注港島西區</h3>
              <p>服務範圍以西營盤及鄰近港島西區住宅為主，路段與樓宇類型都較熟悉。</p>
            </div>
            <div class="value-item">
              <span class="value-item__num">03</span>
              <h3>電話直接聯絡</h3>
              <p>公司與代理電話公開，查詢、預約睇樓可直接致電，不必經過多重轉接。</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Street impressions -->
    <section class="section section--tight section--warm">
      <div class="container">
        <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:38px;">
          <div>
            <span class="eyebrow">Street Impressions</span>
            <h2 class="section-title" style="margin-top:18px;">一條街，幾種生活</h2>
          </div>
          <p class="lede" style="max-width:400px;">西營盤的舊鋪、石階、街市與住宅大廈，構成了這區找樓時最實際的背景。</p>
        </div>
        <div class="gallery">
          <figure class="figure gallery__a" style="aspect-ratio:16/10;">
            <img src="/images/street-shops.webp" alt="舊唐樓轉角的綠色鐵窗、條紋遮陽篷與關上的捲閘" width="2496" height="1664" loading="lazy" decoding="async" />
          </figure>
          <figure class="figure gallery__b" style="aspect-ratio:4/5;">
            <img src="/images/tower-facade.webp" alt="香港舊式住宅大廈外立面，密集窗戶與窗口式冷氣機" width="1728" height="2304" loading="lazy" decoding="async" />
          </figure>
          <figure class="figure gallery__c" style="aspect-ratio:4/5;">
            <img src="/images/stone-steps.webp" alt="西營盤石階小巷與兩旁舊牆" width="1728" height="2304" loading="lazy" decoding="async" />
          </figure>
          <figure class="figure gallery__d" style="aspect-ratio:16/9;">
            <img src="/images/market-lane.webp" alt="西營盤街市附近關上捲閘的檔口與濕潤路面" width="2496" height="1664" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-band__inner">
        <div>
          <span class="eyebrow eyebrow--light">Get in touch</span>
          <h2>有樓想放？有屋想搵？</h2>
          <p>不論是買賣、租賃，或只是想先了解西營盤的市況，歡迎直接致電或親臨第三街門市傾一傾。</p>
        </div>
        <div class="cta-band__actions">
          <a class="btn btn--gold" href="tel:+85294310299">致電 9431 0299 <span class="arrow">→</span></a>
          <a class="btn btn--outline" href="/contact">查看聯絡資料</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
