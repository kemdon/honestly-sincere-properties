---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const details = [
  {
    name: '住宅買賣',
    en: 'Sales & Purchase',
    body: '由了解預算與所需路段開始，按條件整理可考慮的選擇，安排實地視察，再進入商議與文件往來的程序。樓齡、朝向、管理狀況與周邊環境，都是看樓時值得逐項留意的細節。',
    note: '涉及法律、稅務或按揭安排，請另行諮詢相關專業人士。',
  },
  {
    name: '住宅租賃',
    en: 'Leasing',
    body: '租客可先說明預算、入住時間與心儀路段；業主可談談單位狀況與出租期望。睇樓安排、租務文件與雙方條件的確認，由代理陪同跟進。',
    note: '租約條款以雙方簽署的正式文件為準。',
  },
  {
    name: '業主放盤',
    en: 'Listing',
    body: '手上有單位打算出售或出租，歡迎先致電談談物業基本資料。我們會就資料整理、拍攝與推廣安排提出做法，再按你的意願進行。',
    note: '放盤資料以業主提供及確認的內容為準。',
  },
  {
    name: '物業諮詢',
    en: 'Consultation',
    body: '想了解西營盤一帶的樓宇類型、市況或換樓時該從哪裡想起，可以先來一通電話。能當下回答的我們直接說，需要查證的也會如實講明。',
    note: '口頭資訊僅供參考，不構成估價報告或投資建議。',
  },
];

const steps = [
  { title: '先聽清楚需要', body: '預算、面積、路段、時間，一通電話或親臨第三街門市，先把條件說清楚。' },
  { title: '按條件整理選擇', body: '就手上可得的資料，整理值得看的選擇，同時講明各項需要留意的地方。' },
  { title: '實地視察', body: '陪同看單位，現場看清採光、噪音、樓宇狀況與周邊街道環境。' },
  { title: '文件與後續', body: '買賣或租賃文件往來，按程序逐項確認；牽涉法律與稅務的問題，建議另行諮詢專業人士。' },
];
---

<Layout
  title="服務範圍 · 買賣、租賃、放盤與物業諮詢"
  description="真誠地產代理有限公司的服務範圍：住宅買賣、住宅租賃、業主放盤與物業諮詢，並說明由查詢、篩選、睇樓到文件往來的基本流程。"
  path="/services"
  ogImage="/images/planning-desk.webp"
>
  <SiteHeader current="/services" />

  <main>
    <section class="page-hero">
      <div class="page-hero__media">
        <img src="/images/planning-desk.webp" alt="" width="2496" height="1664" decoding="async" />
      </div>
      <span class="page-hero__ghost" aria-hidden="true">02</span>
      <div class="container page-hero__inner">
        <p class="breadcrumb"><a href="/">首頁</a>　/　服務範圍</p>
        <span class="eyebrow eyebrow--light" style="margin-top:26px;">What we do</span>
        <h1>服務範圍</h1>
        <p>買屋、租屋、放盤、諮詢，四件我們每天在做的事。以下把範圍與做法攤開來講，方便你決定怎樣找我們幫忙。</p>
      </div>
    </section>

    <section class="section">
      <div class="container split split--even">
        <div class="reveal">
          <span class="eyebrow">A straightforward approach</span>
          <div class="prose-block" style="margin-top:26px;">
            <h2>先把話說清楚，再談其他</h2>
            <p>地產代理的工作，很大部分是整理資料、安排視察與來回確認。我們不會把程序說得很神秘——<strong>你能夠要求的，是清楚的解釋、如實的資料，以及找得到的人</strong>。</p>
            <p>門市設於西營盤第三街，服務範圍以港島西區住宅為主。不論你是準買家、租客、業主，或只是想先了解區內情況，都可以直接致電 <a href="tel:+85294310299" style="color:var(--brass); border-bottom:1px solid var(--brass-pale);">9431 0299</a> 查詢。</p>
            <p>網站不設即時盤源清單；物業資料、價錢與可供參觀時間，請以電話查詢及正式文件為準。</p>
          </div>
        </div>
        <figure class="figure figure--wide reveal" style="margin:0;">
          <img src="/images/keys-desk.webp" alt="桌上的門匙、住宅平面圖、文件夾、卷尺與茶杯" width="2496" height="1664" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="section section--warm">
      <div class="container">
        <div style="margin-bottom:56px;">
          <div class="section-head__top"><span class="num">01</span><span class="eyebrow">Services in detail</span></div>
          <h2 class="section-title" style="margin-top:20px;">四類服務，逐項說明</h2>
        </div>

        <div style="display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:0 clamp(40px,6vw,90px);" class="service-detail-grid">
          {details.map((item, i) => (
            <article style="border-top:1px solid var(--line); padding:32px 0 36px;" class="reveal">
              <div style="display:flex; align-items:baseline; gap:16px; margin-bottom:16px;">
                <span class="num">0{i + 1}</span>
                <h3 style="font-size:1.45rem; letter-spacing:0.07em;">{item.name}</h3>
                <span class="en" style="color:var(--brass); font-size:0.86rem;">{item.en}</span>
              </div>
              <p style="color:var(--muted); line-height:2; font-size:0.94rem;">{item.body}</p>
              <p style="color:var(--brass); font-size:0.8rem; margin-top:16px; letter-spacing:0.04em;">※ {item.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--ink">
      <div class="container split">
        <div class="reveal">
          <div class="section-head__top"><span class="num">02</span><span class="eyebrow eyebrow--light">The process</span></div>
          <h2 class="section-title" style="margin-top:22px;">大致會怎樣進行</h2>
          <p class="lede" style="margin-top:20px; max-width:420px;">每宗買賣或租賃的情況都不同，以下是一般會走過的幾個階段，實際安排以雙方確認為準。</p>
          <figure class="figure figure--tall" style="margin-top:36px; max-width:380px;">
            <img src="/images/tower-facade.webp" alt="香港舊式住宅大廈外立面，密集窗戶與窗口式冷氣機" width="1728" height="2304" loading="lazy" decoding="async" />
          </figure>
        </div>
        <div class="reveal" style="padding-top:8px;">
          <div class="numbered-steps" style="border-color:var(--line-light);">
            {steps.map((step) => (
              <div class="numbered-steps__item" style="border-color:var(--line-light);">
                <div>
                  <h3 style="color:var(--paper);">{step.title}</h3>
                  <p style="color:rgba(246,243,236,0.66);">{step.body}</p>
                </div>
              </div>
            ))}
          </div>
          <a class="btn btn--gold" href="/contact" style="margin-top:40px;">預約查詢 <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container split split--even">
        <figure class="figure figure--wide reveal" style="margin:0;">
          <img src="/images/interior-living.webp" alt="採光良好的香港住宅客廳，木地板與面向樓群的窗戶" width="2496" height="1664" loading="lazy" decoding="async" />
        </figure>
        <div class="reveal">
          <span class="eyebrow">Before you decide</span>
          <div class="prose-block" style="margin-top:24px;">
            <h2>看樓時，值得多問幾句</h2>
            <p>相片與資料只能說明一部分。實地視察時，建議留意採光與通風、窗外景觀、樓宇公用部分的保養、升降機與管理情況，以及不同時段的街道噪音。</p>
            <p>我們會陪同視察並如實講述現場觀察所得；涉及結構、法律、稅務或按揭的專業判斷，則應由相關專業人士提供意見。</p>
          </div>
          <a class="text-link" href="/contact" style="margin-top:28px;">聯絡我們安排睇樓 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-band__inner">
        <div>
          <span class="eyebrow eyebrow--light">Talk to us</span>
          <h2>想先問清楚，再決定？</h2>
          <p>一個電話就能開始。告訴我們你的情況，能幫的我們會說，幫不上的也不會含糊。</p>
        </div>
        <div class="cta-band__actions">
          <a class="btn btn--gold" href="tel:+85294310299">致電 9431 0299 <span class="arrow">→</span></a>
          <a class="btn btn--outline" href="/contact">查看聯絡資料</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  @media (max-width: 760px) {
    .service-detail-grid { grid-template-columns: 1fr !important; }
  }
</style>
